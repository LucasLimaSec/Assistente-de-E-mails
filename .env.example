# Copie para .env e preencha. O .env nunca vai para o git.

# Opcional: só se llm.provider for claude. Claude Console > API Keys
ANTHROPIC_API_KEY=

# @BotFather > /newbot
TELEGRAM_BOT_TOKEN=
# Seu chat_id (mande /start ao bot e veja em https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=

# Duas variáveis por conta, com os nomes definidos em endereco_env e senha_env no config.yaml.
# Gmail: Conta Google > Segurança > Verificação em duas etapas > Senhas de app
GMAIL_PESSOAL_ENDERECO=
GMAIL_PESSOAL_SENHA_APP=

# Opcional (agenda.enabled: true): Google Agenda > Configurações da agenda >
# "Endereço secreto no formato iCal"
GOOGLE_AGENDA_ICAL_URL=

# Seu perfil profissional, usado para escolher as oportunidades que mais combinam.
# Ex.: PERFIL_OPORTUNIDADES="Desenvolvimento web, Python, integrações de API"
PERFIL_OPORTUNIDADES=
